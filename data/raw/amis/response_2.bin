                    <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.6.1/jquery.min.js"></script>
  <script type="text/javascript">
  // JavaScript will go here
  $(function(){
 
    // Specify the ZIP/location code and units (f or c)
    var loc = 'PKXX0011'; // or e.g. SPXX0050 at weather.com
    var loc2 = 'PKXX0022'
    var loc3 = 'PKXX0002'
    var loc4 = 'PKXX0015'
    var u = 'c';
 
    var query = "SELECT item.condition FROM weather.forecast WHERE location='" + loc + "' AND u='" + u + "'";
    var query2 = "SELECT item.condition FROM weather.forecast WHERE location='" + loc2 + "' AND u='" + u + "'";
    var query3 = "SELECT item.condition FROM weather.forecast WHERE location='" + loc3 + "' AND u='" + u + "'";
    var query4 = "SELECT item.condition FROM weather.forecast WHERE location='" + loc4 + "' AND u='" + u + "'";
    var cacheBuster = Math.floor((new Date().getTime()) / 1200 / 1000);
    var url = 'http://query.yahooapis.com/v1/public/yql?q=' + encodeURIComponent(query) + '&format=json&_nocache=' + cacheBuster;
    var url2 = 'http://query.yahooapis.com/v1/public/yql?q=' + encodeURIComponent(query2) + '&format=json&_nocache=' + cacheBuster;
    var url3 = 'http://query.yahooapis.com/v1/public/yql?q=' + encodeURIComponent(query3) + '&format=json&_nocache=' + cacheBuster;
    var url4 = 'http://query.yahooapis.com/v1/public/yql?q=' + encodeURIComponent(query4) + '&format=json&_nocache=' + cacheBuster;
    window['wxCallback'] = function(data) {
        var info = data.query.results.channel.item.condition;
        $('#wxIcon').css({
            backgroundPosition: '-' + (61 * info.code) + 'px 0'
        }).attr({
            title: info.text
        });
        $('#wxIcon2').append('<img src="http://l.yimg.com/a/i/us/we/52/' + info.code + '.gif" width="34" height="34" title="' + info.text + '" />');
        $('#wxTemp').html(info.temp + '&deg;' + (u.toUpperCase()));
        
    };
 
    $.ajax({
        url: url,
        dataType: 'jsonp',
        cache: true,
        jsonpCallback: 'wxCallback'
    });
    window['wxCallback2'] = function(data) {
        var info = data.query.results.channel.item.condition;
        $('#wxIcon').css({
            backgroundPosition: '-' + (61 * info.code) + 'px 0'
        }).attr({
            title: info.text
        });
      
        $('#wxIcon3').append('<img src="http://l.yimg.com/a/i/us/we/52/' + info.code + '.gif" width="34" height="34" title="' + info.text + '" />');
        $('#wxTemp2').html(info.temp + '&deg;' + (u.toUpperCase()));
    };
    $.ajax({
        url: url2,
        dataType: 'jsonp',
        cache: true,
        jsonpCallback: 'wxCallback2'
    });
     window['wxCallback3'] = function(data) {
        var info = data.query.results.channel.item.condition;
        $('#wxIcon').css({
            backgroundPosition: '-' + (61 * info.code) + 'px 0'
        }).attr({
            title: info.text
        });
      
        $('#wxIcon4').append('<img src="http://l.yimg.com/a/i/us/we/52/' + info.code + '.gif" width="34" height="34" title="' + info.text + '" />');
        $('#wxTemp3').html(info.temp + '&deg;' + (u.toUpperCase()));
    };
    $.ajax({
        url: url3,
        dataType: 'jsonp',
        cache: true,
        jsonpCallback: 'wxCallback3'
    });
     window['wxCallback4'] = function(data) {
        var info = data.query.results.channel.item.condition;
        $('#wxIcon').css({
            backgroundPosition: '-' + (61 * info.code) + 'px 0'
        }).attr({
            title: info.text
        });
      
        $('#wxIcon5').append('<img src="http://l.yimg.com/a/i/us/we/52/' + info.code + '.gif" width="34" height="34" title="' + info.text + '" />');
        $('#wxTemp4').html(info.temp + '&deg;' + (u.toUpperCase()));
    };
    $.ajax({
        url: url4,
        dataType: 'jsonp',
        cache: true,
        jsonpCallback: 'wxCallback4'
    });
});
  </script>

