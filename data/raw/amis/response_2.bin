    <script type="text/javascript">
        function price_addelement() {

            var eleprice = document.getElementById("Prices");


            if (eleprice.style.display == "block") {
                eleprice.style.display = "none";

            } else {
                if (document.getElementById("pub1").style.display == "block" || document.getElementById("stakeholder").style.display == "block" || document.getElementById("import").style.display == "block") {
                    document.getElementById("pub1").style.display = "none";
                    document.getElementById("stakeholder").style.display = "none";
                    document.getElementById("import").style.display = "none";
                    // document.getElementById("contacts").style.display = "none"
                }
                eleprice.style.display = "block";

            }
            //alert(myUL);
        }

        function pub() {



            var i;
            var ele = document.getElementById("pub1");


            if (ele.style.display == "block") {
                ele.style.display = "none";
            } else {
                if (document.getElementById("Prices").style.display == "block" || document.getElementById("stakeholder").style.display == "block" || document.getElementById("import").style.display == "block") {
                    document.getElementById("Prices").style.display = "none";
                    document.getElementById("stakeholder").style.display = "none";
                    document.getElementById("import").style.display = "none";
                    //   document.getElementById("contacts").style.display = "none"
                }

                ele.style.display = "block";
            }



        }

        function stake() {




            var stakeele = document.getElementById("stakeholder");


            if (stakeele.style.display == "block") {
                stakeele.style.display = "none";
            } else {

                if (document.getElementById("Prices").style.display == "block" || document.getElementById("pub1").style.display == "block" || document.getElementById("import").style.display == "block") {
                    document.getElementById("Prices").style.display = "none";
                    document.getElementById("pub1").style.display = "none";
                    document.getElementById("import").style.display = "none";
                    //document.getElementById("contacts").style.display = "none"
                }
                stakeele.style.display = "block";
            }



        }

        function stat() {




            var contactele = document.getElementById("stats");


            if (contactele.style.display == "block") {
                contactele.style.display = "none";
            } else {

                if (document.getElementById("Prices").style.display == "block" || document.getElementById("pub1").style.display == "block" || document.getElementById("import").style.display == "block" || document.getElementById("stakeholder").style.display == "block") {
                    document.getElementById("Prices").style.display = "none";
                    document.getElementById("pub1").style.display = "none";
                    document.getElementById("import").style.display = "none";
                    document.getElementById("stakeholder").style.display = "none"
                }
                contactele.style.display = "block";
            }

        }
        function importe() {




            var contactele = document.getElementById("import");


            if (contactele.style.display == "block") {
                contactele.style.display = "none";
            } else {
                if (document.getElementById("Prices").style.display == "block" || document.getElementById("pub1").style.display == "block") {
                    document.getElementById("Prices").style.display = "none";
                    document.getElementById("pub1").style.display = "none";
                    document.getElementById("contacts").style.display = "none";
                    //document.getElementById("stakeholder").style.display = "none"
                }
                contactele.style.display = "block";
            }



        }
    </script>



